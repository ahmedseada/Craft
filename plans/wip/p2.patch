+++ b/plugins/Craft.Plugins.Telemetry/EditorProgressReporter.cs
@@ -0,0 +1,291 @@
+// Copyright (c) 2026 Ahmed Seada
+// Licensed under the Apache License, Version 2.0. See LICENSE in the repository root.
+
+using System.Diagnostics;
+using Craft.Abstractions;
+using Idrak.Abstraction.Diagnostics;
+
+namespace Craft.Plugins.Telemetry;
+
+/// <summary>
+/// Idrak's progress reporter "editor" (in <see cref="ProgressReporters"/>, a new kind): each piece of work a library or a
+/// plug-in starts with <c>ProgressReporters.Start(label, total, unit, new ProgressOptions { Reporter = "editor" })</c>
+/// shows in the editor's status bar (the host's <see cref="IEditorHost.StartProgress"/>; phase U's activities take that
+/// over) as the library's own line ("pull model.gguf  45%  1.2 GB / 2.7 GB  31 MB/s  48s left"), the share done when the
+/// total is known, at most once per <c>progressMs</c>, and is taken off when it ends. With no editor plug-in active (the
+/// idrak tool loading this assembly) a reporter counts only, like the library's "quiet".
+/// </summary>
+public sealed class EditorProgressReporterKind : IProgressReporterKind
+{
+    /// <summary>The reporter's name.</summary>
+    public const string ReporterName = "editor";
+
+    private static readonly Lock Gate = new();
+    private static (IEditorHost Host, TimeSpan Interval)? s_target;
+
+    private EditorProgressReporterKind()
+    {
+    }
+
+    /// <summary>The kind.</summary>
+    public static EditorProgressReporterKind Instance { get; } = new();
+
+    /// <inheritdoc />
+    public string Name => ReporterName;
+
+    /// <inheritdoc />
+    public string Summary => "The editor's status bar: the stage, the share done, the speed and the time left (the telemetry plug-in's)";
+
+    /// <inheritdoc />
+    public IReadOnlySet<string> Keys { get; } = new HashSet<string>();
+
+    /// <summary>The host the reporters show in now, or null.</summary>
+    internal static IEditorHost? Host
+    {
+        get
+        {
+            lock (Gate)
+            {
+                return s_target?.Host;
+            }
+        }
+    }
+
+    /// <inheritdoc />
+    public IProgressReporter Create(ProgressRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        (IEditorHost Host, TimeSpan Interval)? target;
+        lock (Gate)
+        {
+            target = s_target;
+        }
+
+        return new EditorProgressReporter(request, target?.Host, request.Interval ?? target?.Interval ?? TimeSpan.FromMilliseconds(250));
+    }
+
+    /// <summary>Shows the reporters made from now on in <paramref name="host"/> until the result is disposed.</summary>
+    internal static IDisposable Attach(IEditorHost host, TimeSpan interval)
+    {
+        lock (Gate)
+        {
+            s_target = (host, interval);
+        }
+
+        return new Detach(host);
+    }
+
+    private sealed class Detach(IEditorHost host) : IDisposable
+    {
+        public void Dispose()
+        {
+            lock (Gate)
+            {
+                if (s_target is { } current && ReferenceEquals(current.Host, host))
+                {
+                    s_target = null;
+                }
+            }
+        }
+    }
+}
+
+/// <summary>
+/// One piece of work in the status bar. Its amounts are set from any thread without a lock (a field write); its line is
+/// made only when it is shown (at most once per interval, the time so far redrawn on a timer for work measured in time),
+/// and reaches the host on its UI thread through <see cref="IEditorHost.Dispatch"/>.
+/// </summary>
+internal sealed class EditorProgressReporter : IProgressReporter
+{
+    private readonly IEditorHost? _host;
+    private readonly long _interval;
+    private readonly Lock _gate = new();
+    private readonly Stopwatch _watch = Stopwatch.StartNew();
+    private IEditorProgress? _progress;   // the UI thread's
+    private Timer? _ticker;
+    private long _done;
+    private long _shownAt = long.MinValue;
+    private bool _ended;
+
+    public EditorProgressReporter(ProgressRequest request, IEditorHost? host, TimeSpan interval)
+    {
+        Label = request.Label;
+        Total = request.Total;
+        Unit = request.Unit;
+        _host = host;
+        _interval = Math.Max(1, (long)(interval.TotalSeconds * Stopwatch.Frequency));
+        Tick();
+        Show();
+    }
+
+    public string Label { get; set; }
+
+    public long? Total { get; set; }
+
+    public ProgressUnit Unit { get; set; }
+
+    public long Done => Interlocked.Read(ref _done);
+
+    public bool Enabled => _host is not null;
+
+    public Func<string>? Detail { get; set; }
+
+    /// <summary>The last line shown (the tests read it), or null.</summary>
+    public string? Shown { get; private set; }
+
+    public void Report(long value)
+    {
+        Interlocked.Exchange(ref _done, value);
+        Draw(force: false);
+    }
+
+    public void Advance(long amount = 1)
+    {
+        Interlocked.Add(ref _done, amount);
+        Draw(force: false);
+    }
+
+    public void Show() => Draw(force: true);
+
+    public void NextStage(string label, long? total, ProgressUnit unit, string? message = null, bool keepLine = true)
+    {
+        ArgumentNullException.ThrowIfNull(label);
+        lock (_gate)
+        {
+            if (keepLine && _host is not null)
+            {
+                string kept = message ?? Line();
+                _host.Dispatch(() => _host.Log(EditorLogLevel.Information, kept));
+            }
+
+            Label = label;
+            Total = total;
+            Unit = unit;
+            Interlocked.Exchange(ref _done, 0);
+            _watch.Restart();
+        }
+
+        Tick();
+        Show();
+    }
+
+    public void Erase()
+    {
+        // A status bar item is never in the way of other output.
+    }
+
+    public void Finish(string? message = null)
+    {
+        string? last;
+        lock (_gate)
+        {
+            if (_ended)
+            {
+                return;
+            }
+
+            _ended = true;
+            last = message ?? Line();
+            Shown = last;
+        }
+
+        End(last);
+    }
+
+    public void Clear()
+    {
+        lock (_gate)
+        {
+            if (_ended)
+            {
+                return;
+            }
+
+            _ended = true;
+        }
+
+        End(null);
+    }
+
+    public void Dispose() => Clear();
+
+    // The library's own text for the state, with the detail when there is one.
+    private string Line()
+    {
+        string line = ProgressText.Format(Label, Done, Total, _watch.Elapsed, Unit);
+        return Detail is { } detail ? line + "  " + detail() : line;
+    }
+
+    private void Draw(bool force)
+    {
+        long now = Stopwatch.GetTimestamp();
+        long shown = Interlocked.Read(ref _shownAt);
+        if (!force && now - shown < _interval || _host is null)
+        {
+            return;                                                  // between showings: a field write and a compare
+        }
+
+        string line;
+        double? fraction;
+        lock (_gate)
+        {
+            if (_ended)
+            {
+                return;
+            }
+
+            Interlocked.Exchange(ref _shownAt, now);
+            line = Line();
+            Shown = line;
+            fraction = Unit != ProgressUnit.Elapsed && Total is > 0 ? Math.Clamp(Done / (double)Total.Value, 0, 1) : null;
+        }
+
+        string title = Label;
+        _host.Dispatch(() =>
+        {
+            if (_progress is null && !_ended)
+            {
+                _progress = _host.StartProgress(title);
+            }
+
+            _progress?.Report(fraction, line);
+        });
+    }
+
+    // Work measured in time redraws its time so far on its own; other work redraws when it reports.
+    private void Tick()
+    {
+        lock (_gate)
+        {
+            _ticker?.Dispose();
+            _ticker = Unit == ProgressUnit.Elapsed && _host is not null && !_ended
+                ? new Timer(_ => Draw(force: true), null, TimeSpan.FromSeconds(0.5), TimeSpan.FromSeconds(0.5))
+                : null;
+        }
+    }
+
+    private void End(string? last)
+    {
+        lock (_gate)
+        {
+            _ticker?.Dispose();
+            _ticker = null;
+        }
+
+        if (_host is null)
+        {
+            return;
+        }
+
+        _host.Dispatch(() =>
+        {
+            if (last is not null)
+            {
+                _host.Log(EditorLogLevel.Information, last);
+            }
+
+            _progress?.Dispose();
+            _progress = null;
+        });
+    }
+}
diff --git a/plugins/Craft.Plugins.Telemetry/ModelMeasuresHook.cs b/plugins/Craft.Plugins.Telemetry/ModelMeasuresHook.cs
new file mode 100644
index 0000000..9596fc4
--- /dev/null
+++ b/plugins/Craft.Plugins.Telemetry/ModelMeasuresHook.cs
@@ -0,0 +1,118 @@
+// Copyright (c) 2026 Ahmed Seada
+// Licensed under the Apache License, Version 2.0. See LICENSE in the repository root.
+
+using System.Globalization;
+using Craft.Abstractions;
+using Idrak.Abstraction;
+using Idrak.Abstraction.Diagnostics;
+
+namespace Craft.Plugins.Telemetry;
+
+/// <summary>
+/// An Idrak telemetry hook at <see cref="TelemetryLevel.Stages"/> (the stages of reading an answer alone, which add no
+/// wait for the device): each prompt pass gives the time to the first token, each chunk of decoding the tokens and their
+/// time, so the last generation's tokens per second. On the generator's thread it only adds to counters; <see cref="Take"/>
+/// (on a timer) turns them into <see cref="ModelMeasures"/>, with the device memory the library holds on that device
+/// (Idrak's <see cref="ComputeResources.GetMemoryUsage"/>), only when something new was measured.
+/// </summary>
+internal sealed class ModelMeasuresHook : ITelemetryHook
+{
+    private readonly Lock _gate = new();
+    private long _tokens;            // decoded since the last prompt pass
+    private TimeSpan _decoding;
+    private long _total;
+    private TimeSpan? _firstToken;
+    private string? _device;
+    private bool _changed;
+
+    public TelemetryLevel Levels => TelemetryLevel.Stages;
+
+    public void OnInferenceStage(in InferenceStage e)
+    {
+        lock (_gate)
+        {
+            switch (e.Stage)
+            {
+                case InferenceStageKind.Prefill:
+                    _firstToken = e.Duration;
+                    _tokens = 0;
+                    _decoding = TimeSpan.Zero;
+                    _device = e.Device;
+                    _changed = true;
+                    break;
+                case InferenceStageKind.DecodeChunk when e.Count > 0:
+                    _tokens += e.Count;
+                    _total += e.Count;
+                    _decoding += e.Duration;
+                    _device = e.Device;
+                    _changed = true;
+                    break;
+            }
+        }
+    }
+
+    /// <summary>The measures since they were last taken, or null when nothing new was measured.</summary>
+    public ModelMeasures? Take()
+    {
+        long tokens, total;
+        TimeSpan decoding;
+        TimeSpan? first;
+        string? device;
+        lock (_gate)
+        {
+            if (!_changed)
+            {
+                return null;
+            }
+
+            _changed = false;
+            (tokens, total, decoding, first, device) = (_tokens, _total, _decoding, _firstToken, _device);
+        }
+
+        long? inUse = null, peak = null;
+        if (device is not null)
+        {
+            try
+            {
+                var usage = ComputeResources.GetMemoryUsage(Device.Parse(device));
+                (inUse, peak) = (usage.InUse, usage.Peak);
+            }
+            catch (Exception error) when (error is ArgumentException or NotSupportedException or InvalidOperationException)
+            {
+                // A device kind this process does not know: its memory is not shown rather than guessed.
+            }
+        }
+
+        return new ModelMeasures
+        {
+            TokensPerSecond = decoding > TimeSpan.Zero && tokens > 0 ? tokens / decoding.TotalSeconds : null,
+            FirstToken = first,
+            Device = device,
+            DeviceMemoryBytes = inUse,
+            DeviceMemoryPeakBytes = peak,
+            TokensGenerated = total,
+        };
+    }
+
+    /// <summary>The status bar's text: "38 tok/s · 1.2 GiB cuda".</summary>
+    public static string Describe(ModelMeasures measures)
+    {
+        ArgumentNullException.ThrowIfNull(measures);
+        var parts = new List<string>(2);
+        if (measures.TokensPerSecond is { } rate)
+        {
+            parts.Add(string.Create(CultureInfo.InvariantCulture, $"{rate:F0} tok/s"));
+        }
+
+        if (measures.DeviceMemoryBytes is { } bytes)
+        {
+            parts.Add(Bytes(bytes) + (measures.Device is { } device ? " " + device : ""));
+        }
+
+        return string.Join(" · ", parts);
+    }
+
+    private static string Bytes(long bytes) => bytes >= 1L << 30
+        ? string.Create(CultureInfo.InvariantCulture, $"{bytes / (double)(1L << 30):F1} GiB")
+        : string.Create(CultureInfo.InvariantCulture, $"{bytes / (double)(1L << 20):F0} MiB");
+}
diff --git a/plugins/Craft.Plugins.Telemetry/TelemetryPlugin.cs b/plugins/Craft.Plugins.Telemetry/TelemetryPlugin.cs
new file mode 100644
index 0000000..c1b2d2e
--- /dev/null
+++ b/plugins/Craft.Plugins.Telemetry/TelemetryPlugin.cs
@@ -0,0 +1,211 @@
+// Copyright (c) 2026 Ahmed Seada
+// Licensed under the Apache License, Version 2.0. See LICENSE in the repository root.
+
+using System.Globalization;
+using Craft.Abstractions;
+using Craft.Plugins.Telemetry;
+using Idrak.Abstraction.Diagnostics;
+using Idrak.Abstraction.Plugins;
+
+[assembly: IdrakPluginPackage(typeof(TelemetryPackage))]
+
+namespace Craft.Plugins.Telemetry;
+
+/// <summary>The assembly's plug-in package: what Craft registers when it loads plugins\Craft.Plugins.Telemetry\.</summary>
+public sealed class TelemetryPackage : IIdrakPluginPackage
+{
+    /// <inheritdoc />
+    public string Name => "Craft.Plugins.Telemetry";
+
+    /// <inheritdoc />
+    public IReadOnlyList<IIdrakPlugin> All { get; } = [new TelemetryRegistration()];
+}
+
+/// <summary>Registers "editor" in Idrak's <see cref="ProgressReporters"/> and the editor plug-in "telemetry", each with how to take it back.</summary>
+public sealed class TelemetryRegistration() : IdrakPlugin(TelemetrySettings.PluginName)
+{
+    /// <inheritdoc />
+    protected override void RegisterParts()
+    {
+        Part(() => ProgressReporters.Register(EditorProgressReporterKind.Instance), () => ProgressReporters.Unregister(EditorProgressReporterKind.ReporterName));
+        Part(() => EditorPlugins.Register(TelemetryPlugin.Instance), () => EditorPlugins.Unregister(TelemetrySettings.PluginName));
+    }
+}
+
+/// <summary>The plug-in's settings (plug-in "telemetry", variables <c>CRAFT_PLUGIN_TELEMETRY_&lt;KEY&gt;</c>).</summary>
+public sealed record TelemetrySettings
+{
+    /// <summary>The plug-in's name.</summary>
+    public const string PluginName = "telemetry";
+
+    /// <summary>The least time between two showings of a progress line, ms (<c>progressMs</c>).</summary>
+    public int ProgressMilliseconds { get; init; } = 250;
+
+    /// <summary>Whether Idrak's telemetry is read (<c>telemetry</c>): tokens per second, first token, device memory.</summary>
+    public bool Telemetry { get; init; } = true;
+
+    /// <summary>How often the measures reach the status bar, the model chip and the telemetry tab, ms (<c>refreshMs</c>).</summary>
+    public int RefreshMilliseconds { get; init; } = 1000;
+
+    /// <summary>Whether the status bar shows the last generation's speed and the device memory (<c>statusItem</c>).</summary>
+    public bool StatusItem { get; init; } = true;
+
+    /// <summary>The settings it declares.</summary>
+    public static IReadOnlyList<PluginSetting> Declared { get; } =
+    [
+        new("progressMs", "250", "The least time between two showings of a model's pull or load progress in the status bar, ms."),
+        new("telemetry", "true", "Whether Idrak's telemetry (its inference stages) is read for tokens per second, the first token and the device memory."),
+        new("refreshMs", "1000", "How often the measured speed and memory reach the status bar, the model chip and the Idrak telemetry tab, ms."),
+        new("statusItem", "true", "Whether the status bar shows the last generation's tokens per second and the device memory in use."),
+    ];
+
+    /// <summary>The settings from <paramref name="settings"/>; a value that does not parse throws, naming its variable.</summary>
+    public static TelemetrySettings From(IPluginSettings settings)
+    {
+        ArgumentNullException.ThrowIfNull(settings);
+        return Read(key => settings.Get(PluginName, key));
+    }
+
+    /// <summary>The settings from <paramref name="value"/> (a key's text, or null for its default).</summary>
+    public static TelemetrySettings Read(Func<string, string?> value)
+    {
+        ArgumentNullException.ThrowIfNull(value);
+        var defaults = new TelemetrySettings();
+        string? Text(string key) => value(key) is { } text && text.Trim() is { Length: > 0 } trimmed ? trimmed : null;
+        int Whole(string key, int fallback, int min, int max) => Text(key) is not { } text ? fallback
+            : int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out int number) && number >= min && number <= max ? number
+            : throw new ArgumentException($"{PluginSetting.VariableName(PluginName, key)} is '{text}': it takes a whole number from {min} to {max}.", key);
+        bool Flag(string key, bool fallback) => Text(key) switch
+        {
+            null => fallback,
+            var t when t.Equals("true", StringComparison.OrdinalIgnoreCase) || t == "1" => true,
+            var t when t.Equals("false", StringComparison.OrdinalIgnoreCase) || t == "0" => false,
+            var t => throw new ArgumentException($"{PluginSetting.VariableName(PluginName, key)} is '{t}': it takes true or false.", key),
+        };
+
+        return new TelemetrySettings
+        {
+            ProgressMilliseconds = Whole("progressMs", defaults.ProgressMilliseconds, 10, 60_000),
+            Telemetry = Flag("telemetry", defaults.Telemetry),
+            RefreshMilliseconds = Whole("refreshMs", defaults.RefreshMilliseconds, 100, 600_000),
+            StatusItem = Flag("statusItem", defaults.StatusItem),
+        };
+    }
+}
+
+/// <summary>
+/// The editor plug-in "telemetry": while it is active, the "editor" progress reporters show in its host's status bar
+/// (<see cref="EditorProgressReporterKind"/>), and Idrak's telemetry is read into the model chip, the status bar and the
+/// telemetry tab (<see cref="ModelMeasuresHook"/>).
+/// </summary>
+public sealed class TelemetryPlugin : IEditorPlugin
+{
+    private TelemetryPlugin()
+    {
+    }
+
+    /// <summary>The plug-in.</summary>
+    public static TelemetryPlugin Instance { get; } = new();
+
+    /// <inheritdoc />
+    public string Name => TelemetrySettings.PluginName;
+
+    /// <inheritdoc />
+    public string Summary => "A model's pull and load in the status bar (stage, share, speed, time left); tokens per second and device memory from Idrak's telemetry";
+
+    /// <inheritdoc />
+    public IReadOnlyList<PluginSetting> Settings => TelemetrySettings.Declared;
+
+    /// <inheritdoc />
+    public IDisposable Activate(IEditorHost host)
+    {
+        ArgumentNullException.ThrowIfNull(host);
+        return new TelemetrySession(host, TelemetrySettings.From(host.Settings));
+    }
+}
+
+/// <summary>The plug-in in one host: the progress bridge, the telemetry hook and the status item. Made and disposed on the UI thread.</summary>
+internal sealed class TelemetrySession : IDisposable
+{
+    private readonly IEditorHost _host;
+    private readonly IDisposable _bridge;
+    private readonly ModelMeasuresHook? _hook;
+    private readonly IDisposable? _subscription;
+    private readonly Timer? _timer;
+    private readonly StatusItem _status = new("telemetry.model", "", StatusAlignment.Right, 8, "craft.showTelemetry");
+    private readonly bool _showStatus;
+    private IDisposable? _statusShown;
+    private int _disposed;
+
+    public TelemetrySession(IEditorHost host, TelemetrySettings settings)
+    {
+        _host = host;
+        _bridge = EditorProgressReporterKind.Attach(host, TimeSpan.FromMilliseconds(settings.ProgressMilliseconds));
+        _showStatus = settings.StatusItem;
+        if (settings.Telemetry)
+        {
+            _hook = new ModelMeasuresHook();
+            _subscription = Idrak.Abstraction.Diagnostics.Telemetry.Subscribe(_hook);
+            var every = TimeSpan.FromMilliseconds(settings.RefreshMilliseconds);
+            _timer = new Timer(_ => Publish(), null, every, every);
+        }
+    }
+
+    // On the timer's thread: the hook's figures, once they changed, to the shell's board, then on the UI thread to the
+    // status item and the telemetry tab.
+    private void Publish()
+    {
+        if (Volatile.Read(ref _disposed) != 0 || _hook?.Take() is not { } measures)
+        {
+            return;
+        }
+
+        ModelTelemetry.Report(measures);
+        _host.Dispatch(() =>
+        {
+            if (Volatile.Read(ref _disposed) != 0)
+            {
+                return;
+            }
+
+            if (measures.TokensPerSecond is { } rate)
+            {
+                _host.Record("idrak.tokensPerSecond", rate, "tok/s");
+            }
+
+            if (measures.FirstToken is { } first)
+            {
+                _host.Record("idrak.firstToken", first.TotalMilliseconds, "ms");
+            }
+
+            if (measures.DeviceMemoryBytes is { } memory)
+            {
+                _host.Record("idrak.deviceMemory", memory / 1048576.0, "MiB");
+            }
+
+            if (_showStatus)
+            {
+                _status.Text = ModelMeasuresHook.Describe(measures);
+                _status.Tooltip = "The last generation, from Idrak's telemetry (its inference stages); the Idrak telemetry tab has every measure.";
+                _statusShown ??= _host.AddStatusItem(_status);
+            }
+        });
+    }
+
+    public void Dispose()
+    {
+        if (Interlocked.Exchange(ref _disposed, 1) != 0)
+        {
+            return;
+        }
+
+        _timer?.Dispose();
+        _subscription?.Dispose();
+        _statusShown?.Dispose();
+        _bridge.Dispose();
+        if (_hook is not null)
+        {
+            ModelTelemetry.Clear();
+        }
+    }
+}
