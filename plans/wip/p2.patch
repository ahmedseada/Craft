+<Project Sdk="Microsoft.NET.Sdk">
+
+  <!--
+    Plug-in P10 of plan phase P, workspace model names: Idrak's ModelSources gains "craft" (a new kind of name), resolving
+    craft:NAME from the open workspace's .craft/model.json (a name stands for a folder, a .gguf file, store:NAME or a Hugging
+    Face id, resolved again by the other sources), and Craft's ModelRoleSources gains "workspace": the file's default model
+    for each role (chat, completion, agent), which the AI plug-in takes for a role the user left empty. So a project pins
+    its models in its own folder, and the same names work in the idrak tool (-P this assembly) from that folder.
+
+    Built only on Craft.Abstractions and Idrak.Abstraction (ModelSources lives there), so it carries no Idrak library of its
+    own. Android (phase M): System.Text.Json's reader only, no reflection.
+  -->
+  <PropertyGroup>
+    <RootNamespace>Craft.Plugins.WorkspaceModels</RootNamespace>
+    <GenerateDocumentationFile>true</GenerateDocumentationFile>
+    <EnableDynamicLoading>true</EnableDynamicLoading>
+  </PropertyGroup>
+
+  <ItemGroup>
+    <InternalsVisibleTo Include="Craft.Tests" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <ProjectReference Include="..\..\src\Craft.Abstractions\Craft.Abstractions.csproj">
+      <Private>false</Private>
+      <ExcludeAssets>runtime</ExcludeAssets>
+    </ProjectReference>
+  </ItemGroup>
+
+  <!-- Idrak.Abstraction comes through Craft.Abstractions; as a contract shared with the host it is not copied either. -->
+  <Target Name="CraftSharedContractsNotCopied" AfterTargets="ResolveAssemblyReferences">
+    <ItemGroup>
+      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Idrak.Abstraction' or '%(Filename)' == 'Craft.Abstractions'" />
+    </ItemGroup>
+  </Target>
+
+</Project>
diff --git a/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelFile.cs b/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelFile.cs
new file mode 100644
index 0000000..d1cacca
--- /dev/null
+++ b/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelFile.cs
@@ -0,0 +1,183 @@
+// Copyright (c) 2026 Ahmed Seada
+// Licensed under the Apache License, Version 2.0. See LICENSE in the repository root.
+
+using System.Collections.Concurrent;
+using System.Text.Json;
+using Craft.Abstractions;
+
+namespace Craft.Plugins.WorkspaceModels;
+
+/// <summary>
+/// A workspace's <c>.craft/model.json</c>, read: the names it defines and the model of each role.
+/// <code>
+/// {
+///   "models": { "coder": "store:qwen2.5-coder:7b", "tiny": "models/tiny", "vision": { "model": "Qwen/Qwen2.5-VL-3B-Instruct" } },
+///   "roles": { "chat": "coder", "completion": "tiny", "agent": "coder" }
+/// }
+/// </code>
+/// A name stands for anything Idrak's model sources resolve (a folder or a .gguf file, relative to the workspace or full,
+/// store:NAME, a Hugging Face id, another craft:NAME); a role names one of the file's names or any model name. Every key
+/// is checked: an unknown field, a role that is not chat, completion or agent, or a value that is not text is refused with
+/// the file's name and where.
+/// </summary>
+public sealed class WorkspaceModelFile
+{
+    /// <summary>The file's place in a workspace.</summary>
+    public static readonly string DefaultPath = System.IO.Path.Combine(".craft", "model.json");
+
+    private static readonly ConcurrentDictionary<string, (WorkspaceModelFile? File, DateTime Stamp, long Length)> Cache = new(StringComparer.Ordinal);
+
+    private WorkspaceModelFile(string path, IReadOnlyDictionary<string, string> models, IReadOnlyDictionary<string, string> roles)
+    {
+        Path = path;
+        Models = models;
+        Roles = roles;
+    }
+
+    /// <summary>The file's full path.</summary>
+    public string Path { get; }
+
+    /// <summary>The names it defines ("coder") and what each stands for, in the file's order.</summary>
+    public IReadOnlyDictionary<string, string> Models { get; }
+
+    /// <summary>Each role's model as the file gives it ("coder", or a model name), by role.</summary>
+    public IReadOnlyDictionary<string, string> Roles { get; }
+
+    /// <summary>The workspace folder (the file's folder's parent).</summary>
+    public string Workspace => System.IO.Path.GetDirectoryName(System.IO.Path.GetDirectoryName(Path)) ?? "";
+
+    /// <summary>
+    /// The file of <paramref name="workspaceFolder"/> at <paramref name="relativePath"/>, or null when it has none: read once
+    /// and kept while its time and length stay the same (so asking again costs a look at the file's times, not a parse).
+    /// </summary>
+    /// <exception cref="InvalidDataException">The file does not read (the message names it and where).</exception>
+    public static WorkspaceModelFile? For(string workspaceFolder, string? relativePath = null)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(workspaceFolder);
+        string path = System.IO.Path.GetFullPath(System.IO.Path.Combine(workspaceFolder, relativePath is { Length: > 0 } r ? r : DefaultPath));
+        var info = new FileInfo(path);
+        if (!info.Exists)
+        {
+            Cache.TryRemove(path, out _);
+            return null;
+        }
+
+        if (Cache.TryGetValue(path, out var kept) && kept.Stamp == info.LastWriteTimeUtc && kept.Length == info.Length)
+        {
+            return kept.File;
+        }
+
+        var file = Parse(path, File.ReadAllBytes(path));
+        Cache[path] = (file, info.LastWriteTimeUtc, info.Length);
+        return file;
+    }
+
+    /// <summary>Reads a model file's bytes (its path for the messages).</summary>
+    /// <exception cref="InvalidDataException">The JSON does not read or holds a field it should not.</exception>
+    public static WorkspaceModelFile Parse(string path, ReadOnlySpan<byte> json)
+    {
+        ArgumentNullException.ThrowIfNull(path);
+        var models = new Dictionary<string, string>(StringComparer.Ordinal);
+        var roles = new Dictionary<string, string>(StringComparer.Ordinal);
+        try
+        {
+            var reader = new Utf8JsonReader(json, new JsonReaderOptions { CommentHandling = JsonCommentHandling.Skip, AllowTrailingCommas = true });
+            Expect(reader.Read() && reader.TokenType == JsonTokenType.StartObject, path, "the file is not a JSON object");
+            while (reader.Read() && reader.TokenType == JsonTokenType.PropertyName)
+            {
+                string field = reader.GetString()!;
+                reader.Read();
+                switch (field)
+                {
+                    case "models":
+                        ReadModels(ref reader, path, models);
+                        break;
+                    case "roles":
+                        ReadRoles(ref reader, path, roles);
+                        break;
+                    default:
+                        throw new InvalidDataException($"{path}: the field '{field}' is not one a model file has (it has \"models\" and \"roles\").");
+                }
+            }
+        }
+        catch (JsonException error)
+        {
+            throw new InvalidDataException($"{path}: not JSON ({error.Message}).", error);
+        }
+
+        return new WorkspaceModelFile(path, models, roles);
+    }
+
+    /// <summary>What <paramref name="name"/> (a role's value, or a name of the file) stands for once the file's names are followed.</summary>
+    public string Target(string name) => Models.TryGetValue(name, out var target) ? target : name;
+
+    /// <summary>The names as the Models page lists them, each with the roles it is the default of.</summary>
+    public IReadOnlyList<NamedModel> Named()
+    {
+        var list = new List<NamedModel>(Models.Count + Roles.Count);
+        foreach (var (name, target) in Models)
+        {
+            list.Add(new NamedModel(WorkspaceModelSource.Prefix + name, target, [.. Roles.Where(r => r.Value == name || r.Value == WorkspaceModelSource.Prefix + name).Select(r => r.Key)]));
+        }
+
+        foreach (var (role, model) in Roles)
+        {
+            if (!Models.ContainsKey(model) && !(model.StartsWith(WorkspaceModelSource.Prefix, StringComparison.Ordinal) && Models.ContainsKey(model[WorkspaceModelSource.Prefix.Length..])))
+            {
+                list.Add(new NamedModel(model, model, [role]));
+            }
+        }
+
+        return list;
+    }
+
+    private static void ReadModels(ref Utf8JsonReader reader, string path, Dictionary<string, string> models)
+    {
+        Expect(reader.TokenType == JsonTokenType.StartObject, path, "\"models\" is not an object of names");
+        while (reader.Read() && reader.TokenType == JsonTokenType.PropertyName)
+        {
+            string name = reader.GetString()!;
+            Expect(name.Length > 0 && !name.Contains(':', StringComparison.Ordinal), path, $"the model name '{name}' is empty or holds a ':'");
+            reader.Read();
+            string? target = null;
+            if (reader.TokenType == JsonTokenType.String)
+            {
+                target = reader.GetString();
+            }
+            else if (reader.TokenType == JsonTokenType.StartObject)
+            {
+                while (reader.Read() && reader.TokenType == JsonTokenType.PropertyName)
+                {
+                    string field = reader.GetString()!;
+                    reader.Read();
+                    Expect(field == "model" && reader.TokenType == JsonTokenType.String, path, $"the model '{name}' has the field '{field}' (it takes \"model\": a name)");
+                    target = reader.GetString();
+                }
+            }
+
+            Expect(target is { Length: > 0 }, path, $"the model '{name}' names nothing (give a folder, a .gguf file, store:NAME or a Hugging Face id)");
+            Expect(models.TryAdd(name, target!.Trim()), path, $"the model '{name}' is named twice");
+        }
+    }
+
+    private static void ReadRoles(ref Utf8JsonReader reader, string path, Dictionary<string, string> roles)
+    {
+        Expect(reader.TokenType == JsonTokenType.StartObject, path, "\"roles\" is not an object of roles");
+        while (reader.Read() && reader.TokenType == JsonTokenType.PropertyName)
+        {
+            string role = reader.GetString()!;
+            Expect(ModelRoles.All.Contains(role, StringComparer.Ordinal), path, $"'{role}' is not a role (the roles: {string.Join(", ", ModelRoles.All)})");
+            reader.Read();
+            Expect(reader.TokenType == JsonTokenType.String && reader.GetString() is { Length: > 0 }, path, $"the role '{role}' names no model");
+            roles[role] = reader.GetString()!.Trim();
+        }
+    }
+
+    private static void Expect(bool condition, string path, string problem)
+    {
+        if (!condition)
+        {
+            throw new InvalidDataException($"{path}: {problem}.");
+        }
+    }
+}
diff --git a/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelSource.cs b/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelSource.cs
new file mode 100644
index 0000000..4333c19
--- /dev/null
+++ b/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelSource.cs
@@ -0,0 +1,122 @@
+// Copyright (c) 2026 Ahmed Seada
+// Licensed under the Apache License, Version 2.0. See LICENSE in the repository root.
+
+using Idrak.Abstraction;
+using Idrak.Abstraction.Formats;
+
+namespace Craft.Plugins.WorkspaceModels;
+
+/// <summary>
+/// Idrak's model source "craft" (in <see cref="ModelSources"/>, a new kind of name): <c>craft:NAME</c> is the name the
+/// workspace's <c>.craft/model.json</c> gives, resolved to what it stands for by the other registered sources (a folder or a
+/// .gguf file relative to the workspace, store:NAME, a Hugging Face id, another craft:NAME). The workspace is the editor's
+/// open folder while the plug-in is active there, else <c>CRAFT_PLUGIN_WORKSPACEMODELS_WORKSPACE</c>, else the current
+/// folder (the idrak tool run in the project). A name the file does not give fails with "not registered", naming the file
+/// and the names it has; nothing falls back to another name.
+/// </summary>
+public sealed class WorkspaceModelSource : IModelSource
+{
+    /// <summary>The source's name.</summary>
+    public const string SourceName = "craft";
+
+    /// <summary>The names' prefix.</summary>
+    public const string Prefix = "craft:";
+
+    private const int MostLinks = 8;
+
+    private static string? s_workspace;
+    private static string? s_file;
+
+    private WorkspaceModelSource()
+    {
+    }
+
+    /// <summary>The source.</summary>
+    public static WorkspaceModelSource Instance { get; } = new();
+
+    /// <inheritdoc />
+    public string Name => SourceName;
+
+    /// <summary>The workspace the names are read from now (the editor's folder while the plug-in is active there), or null.</summary>
+    public static string? Workspace
+    {
+        get => Volatile.Read(ref s_workspace)
+               ?? (Environment.GetEnvironmentVariable(WorkspaceModelSettings.Variable("workspace")) is { Length: > 0 } set ? set : Environment.CurrentDirectory);
+        internal set => Volatile.Write(ref s_workspace, value);
+    }
+
+    /// <summary>The model file's path in a workspace (the setting <c>file</c>).</summary>
+    public static string File
+    {
+        get => Volatile.Read(ref s_file)
+               ?? (Environment.GetEnvironmentVariable(WorkspaceModelSettings.Variable("file")) is { Length: > 0 } set ? set : WorkspaceModelFile.DefaultPath);
+        internal set => Volatile.Write(ref s_file, value);
+    }
+
+    /// <summary>Back to the defaults (the plug-in deactivated): the environment's workspace and file.</summary>
+    internal static void Reset()
+    {
+        Volatile.Write(ref s_workspace, null);
+        Volatile.Write(ref s_file, null);
+    }
+
+    /// <inheritdoc />
+    public bool CanResolve(string model) => model is not null && model.StartsWith(Prefix, StringComparison.Ordinal) && model.Length > Prefix.Length;
+
+    /// <inheritdoc />
+    public string Resolve(string model, ModelSourceOptions options)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+        string target = Target(model, Workspace);
+        var source = ModelSources.For(target)
+                     ?? throw new NotRegisteredException(nameof(ModelSources), target, ModelSources.Names,
+                         $"'{model}' stands for '{target}', which no model source resolves (registered: {string.Join(", ", ModelSources.Names)}).");
+        return source.Resolve(target, options);
+    }
+
+    /// <summary>
+    /// What <paramref name="model"/> (<c>craft:NAME</c>) stands for in <paramref name="workspace"/>, its links followed: a
+    /// relative path that is there becomes full.
+    /// </summary>
+    /// <exception cref="NotRegisteredException">The workspace's file does not give the name (or the workspace has no file).</exception>
+    /// <exception cref="InvalidDataException">The file does not read, or its names link in a circle.</exception>
+    public static string Target(string model, string? workspace)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(model);
+        string name = model;
+        for (int link = 0; link < MostLinks; link++)
+        {
+            if (!name.StartsWith(Prefix, StringComparison.Ordinal))
+            {
+                return Place(name, workspace);
+            }
+
+            string key = name[Prefix.Length..];
+            var file = workspace is null ? null : WorkspaceModelFile.For(workspace, File);
+            if (file is null || !file.Models.TryGetValue(key, out var target))
+            {
+                string where = workspace is null ? "no workspace is open" : Path.Combine(workspace, File);
+                var known = file?.Models.Keys.Select(k => Prefix + k).ToList() ?? [];
+                throw new NotRegisteredException("workspace model names", name, known, file is null
+                    ? $"The model name '{name}' is not registered: {where} {(workspace is null ? "" : "does not exist")} (a workspace names its models in .craft/model.json under \"models\")."
+                    : $"The model name '{name}' is not registered in {where} (names there: {(known.Count == 0 ? "none" : string.Join(", ", known))}); add it under \"models\".");
+            }
+
+            name = target;
+        }
+
+        throw new InvalidDataException($"'{model}': its names link more than {MostLinks} times (a circle in {File}?).");
+    }
+
+    // A relative folder or file of the workspace (that is there) as a full path; any other name as it is.
+    private static string Place(string target, string? workspace)
+    {
+        if (workspace is null || Path.IsPathFullyQualified(target) || target.Contains(':', StringComparison.Ordinal))
+        {
+            return target;
+        }
+
+        string full = Path.GetFullPath(Path.Combine(workspace, target));
+        return Directory.Exists(full) || System.IO.File.Exists(full) ? full : target;
+    }
+}
diff --git a/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelsPlugin.cs b/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelsPlugin.cs
new file mode 100644
index 0000000..debcc70
--- /dev/null
+++ b/plugins/Craft.Plugins.WorkspaceModels/WorkspaceModelsPlugin.cs
@@ -0,0 +1,215 @@
+// Copyright (c) 2026 Ahmed Seada
+// Licensed under the Apache License, Version 2.0. See LICENSE in the repository root.
+
+using Craft.Abstractions;
+using Craft.Plugins.WorkspaceModels;
+using Idrak.Abstraction.Formats;
+using Idrak.Abstraction.Plugins;
+
+[assembly: IdrakPluginPackage(typeof(WorkspaceModelsPackage))]
+
+namespace Craft.Plugins.WorkspaceModels;
+
+/// <summary>The assembly's plug-in package: what Craft (or the idrak tool's -P) registers when it loads this plug-in.</summary>
+public sealed class WorkspaceModelsPackage : IIdrakPluginPackage
+{
+    /// <inheritdoc />
+    public string Name => "Craft.Plugins.WorkspaceModels";
+
+    /// <inheritdoc />
+    public IReadOnlyList<IIdrakPlugin> All { get; } = [new WorkspaceModelsRegistration()];
+}
+
+/// <summary>
+/// Registers "craft" in Idrak's <see cref="ModelSources"/>, "workspace" in Craft's <see cref="ModelRoleSources"/>, the editor
+/// plug-in and its command, each with how to take it back.
+/// </summary>
+public sealed class WorkspaceModelsRegistration() : IdrakPlugin(WorkspaceModelSettings.PluginName)
+{
+    /// <inheritdoc />
+    protected override void RegisterParts()
+    {
+        Part(() => ModelSources.Register(WorkspaceModelSource.Instance), () => ModelSources.Unregister(WorkspaceModelSource.SourceName));
+        Part(() => ModelRoleSources.Register(WorkspaceRoleSource.Instance), () => ModelRoleSources.Unregister(WorkspaceRoleSource.SourceName));
+        Part(() => EditorPlugins.Register(WorkspaceModelsPlugin.Instance), () => EditorPlugins.Unregister(WorkspaceModelSettings.PluginName));
+        Part(() => EditorCommands.Register(WorkspaceModelsPlugin.EditCommand), () => EditorCommands.Unregister(WorkspaceModelsPlugin.EditCommand.Name));
+    }
+}
+
+/// <summary>The plug-in's settings (plug-in "workspaceModels", variables <c>CRAFT_PLUGIN_WORKSPACEMODELS_&lt;KEY&gt;</c>).</summary>
+public static class WorkspaceModelSettings
+{
+    /// <summary>The plug-in's name.</summary>
+    public const string PluginName = "workspaceModels";
+
+    /// <summary>The settings it declares.</summary>
+    public static IReadOnlyList<PluginSetting> Declared { get; } =
+    [
+        new("file", WorkspaceModelFile.DefaultPath, "The workspace's model file, relative to the workspace: its names (craft:NAME) and the model of each role."),
+        new("workspace", "", "The workspace the names are read from outside the editor (the idrak tool); empty: the current folder. In the editor: the open folder."),
+    ];
+
+    /// <summary>The variable of <paramref name="key"/>.</summary>
+    public static string Variable(string key) => PluginSetting.VariableName(PluginName, key);
+}
+
+/// <summary>
+/// Craft's model role source "workspace": the model the workspace's file gives each role (a name of the file as
+/// <c>craft:NAME</c>, any other model name as it is, a relative folder made full), and the names it defines for the Models
+/// page. Read from the file kept in memory while it is unchanged (the plug-in reads it off the UI thread when the folder opens).
+/// </summary>
+public sealed class WorkspaceRoleSource : IModelRoleSource
+{
+    /// <summary>The source's name.</summary>
+    public const string SourceName = "workspace";
+
+    private WorkspaceRoleSource()
+    {
+    }
+
+    /// <summary>The source.</summary>
+    public static WorkspaceRoleSource Instance { get; } = new();
+
+    /// <inheritdoc />
+    public string Name => SourceName;
+
+    /// <inheritdoc />
+    public string Summary => "The workspace's .craft/model.json: its names (craft:NAME) and the model of each role";
+
+    /// <inheritdoc />
+    public string? ModelFor(string role, string? workspaceFolder)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(role);
+        if (workspaceFolder is null || WorkspaceModelFile.For(workspaceFolder, WorkspaceModelSource.File) is not { } file || !file.Roles.TryGetValue(role, out var model))
+        {
+            return null;
+        }
+
+        if (file.Models.ContainsKey(model))
+        {
+            return WorkspaceModelSource.Prefix + model;
+        }
+
+        return model.StartsWith(WorkspaceModelSource.Prefix, StringComparison.Ordinal) || Path.IsPathFullyQualified(model) || model.Contains(':', StringComparison.Ordinal)
+            ? model
+            : Path.GetFullPath(Path.Combine(workspaceFolder, model)) is var full && (Directory.Exists(full) || File.Exists(full)) ? full : model;
+    }
+
+    /// <inheritdoc />
+    public IReadOnlyList<NamedModel> Names(string? workspaceFolder) =>
+        workspaceFolder is not null && WorkspaceModelFile.For(workspaceFolder, WorkspaceModelSource.File) is { } file ? file.Named() : [];
+
+    /// <inheritdoc />
+    public string? FileFor(string? workspaceFolder) => workspaceFolder is null ? null : Path.GetFullPath(Path.Combine(workspaceFolder, WorkspaceModelSource.File));
+}
+
+/// <summary>
+/// The editor plug-in "workspaceModels": while active, the names come from the editor's open folder (read off the UI
+/// thread when it opens or changes, so the AI plug-in's settings never wait on the file), and the command
+/// "Models: Edit the workspace's models" opens <c>.craft/model.json</c> (a new one when there is none).
+/// </summary>
+public sealed class WorkspaceModelsPlugin : IEditorPlugin
+{
+    private WorkspaceModelsPlugin()
+    {
+    }
+
+    /// <summary>The plug-in.</summary>
+    public static WorkspaceModelsPlugin Instance { get; } = new();
+
+    /// <summary>Opens the workspace's model file.</summary>
+    public static IEditorCommand EditCommand { get; } = new EditorCommand("workspaceModels.edit", "Models: Edit the workspace's models (.craft/model.json)",
+        async (host, token) =>
+        {
+            if (host.WorkspaceFolder is not { } folder)
+            {
+                await host.ShowMessageAsync("Models", "Open a folder first: a workspace names its models in its .craft/model.json.").ConfigureAwait(true);
+                return;
+            }
+
+            string path = Path.GetFullPath(Path.Combine(folder, WorkspaceModelSource.File));
+            if (await host.OpenDocumentAsync(path, token).ConfigureAwait(true) is null)
+            {
+                await host.ShowMessageAsync("Models", $"Could not open {path}.").ConfigureAwait(true);
+            }
+        }, host => host.WorkspaceFolder is not null);
+
+    /// <inheritdoc />
+    public string Name => WorkspaceModelSettings.PluginName;
+
+    /// <inheritdoc />
+    public string Summary => "Workspace model names: craft:NAME from the project's .craft/model.json, and its model for chat, completion and the agent";
+
+    /// <inheritdoc />
+    public IReadOnlyList<PluginSetting> Settings => WorkspaceModelSettings.Declared;
+
+    /// <inheritdoc />
+    public IDisposable Activate(IEditorHost host)
+    {
+        ArgumentNullException.ThrowIfNull(host);
+        return new Session(host);
+    }
+
+    private sealed class Session : IDisposable
+    {
+        private readonly IEditorHost _host;
+        private string? _folder;
+
+        public Session(IEditorHost host)
+        {
+            _host = host;
+            WorkspaceModelSource.File = host.Settings.Get(WorkspaceModelSettings.PluginName, "file") is { Length: > 0 } file ? file : WorkspaceModelFile.DefaultPath;
+            host.ActiveDocumentChanged += OnChanged;
+            host.DocumentSaved += OnSaved;
+            Follow();
+        }
+
+        public void Dispose()
+        {
+            _host.ActiveDocumentChanged -= OnChanged;
+            _host.DocumentSaved -= OnSaved;
+            WorkspaceModelSource.Reset();
+        }
+
+        private void OnChanged(object? sender, EventArgs e) => Follow();
+
+        // The model file saved in the editor: read again off the UI thread.
+        private void OnSaved(object? sender, EditorDocumentEventArgs e)
+        {
+            if (_folder is not null && e.Document.FilePath is { } path
+                && string.Equals(Path.GetFullPath(path), Path.GetFullPath(Path.Combine(_folder, WorkspaceModelSource.File)), StringComparison.OrdinalIgnoreCase))
+            {
+                Preload(_folder);
+            }
+        }
+
+        // The editor's folder, when it changed: the source reads its names from it, the file read off the UI thread.
+        private void Follow()
+        {
+            string? folder = _host.WorkspaceFolder;
+            if (string.Equals(folder, _folder, StringComparison.Ordinal))
+            {
+                return;
+            }
+
+            _folder = folder;
+            WorkspaceModelSource.Workspace = folder;
+            if (folder is not null)
+            {
+                Preload(folder);
+            }
+        }
+
+        private void Preload(string folder) => _ = Task.Run(() =>
+        {
+            try
+            {
+                _ = WorkspaceModelFile.For(folder, WorkspaceModelSource.File);
+            }
+            catch (Exception error) when (error is InvalidDataException or IOException or UnauthorizedAccessException)
+            {
+                _host.Dispatch(() => _host.Log(EditorLogLevel.Warning, error.Message));
+            }
+        });
+    }
+}
