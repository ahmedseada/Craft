<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Angular as a pre-installed, removable plug-in (plan phase W, W-markup): "angular-html" templates and "angular-typescript" (inline
    templates and styles), their colours, folding, format, icons, settings and the angular.json selector. The lexers are Craft.Web's (src/Craft.Web,
    Markup/, with Script/ and Style/ for the embedded languages), referenced as a plain copied project so Craft.Web.dll lands
    in this plug-in's own folder and loads in its own context. Craft.Abstractions is the host's (not copied). Android and AOT:
    pure C#, no reflection, nothing native (IsAotCompatible, trim-safe); angular.json and package.json are read with Utf8JsonReader.
  -->
  <PropertyGroup>
    <RootNamespace>Craft.Plugins.Angular</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Craft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Craft.Abstractions\Craft.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Craft.Web\Craft.Web.csproj" />
  </ItemGroup>

  <!-- The contracts shared with the host are not copied. -->
  <Target Name="CraftSharedContractsNotCopied" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Idrak.Abstraction' or '%(Filename)' == 'Craft.Abstractions'" />
    </ItemGroup>
  </Target>

</Project>
