<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JSON as a pre-installed, removable plug-in (plan phase W, W0): the "json" language (colours, brackets, folding, format,
    icons), moved out of the C# plug-in so a web project's package.json and tsconfig.json keep their colours without C#. It
    references Craft.Abstractions alone (the public line-state kit), as a third party's language does. Android and AOT:
    pure C#, no reflection, nothing native (IsAotCompatible).
  -->
  <PropertyGroup>
    <RootNamespace>Craft.Plugins.Json</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Craft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Craft.Abstractions\Craft.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- The contracts shared with the host are not copied. -->
  <Target Name="CraftSharedContractsNotCopied" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Idrak.Abstraction' or '%(Filename)' == 'Craft.Abstractions'" />
    </ItemGroup>
  </Target>

</Project>
