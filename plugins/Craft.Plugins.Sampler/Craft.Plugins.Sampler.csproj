<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plug-in P3 of plan phase P, the bracket-balanced completion sampler: an Idrak token sampler kind registered over the
    library's "default" in TokenSamplers (the slot shadows the built-in, which it delegates to and which Unregister brings
    back). On a fill-in-the-middle completion it masks every token that would close a brace, a parenthesis or a bracket the
    prefix never opened (brackets inside a string or a character literal are text); where nothing would be closed it hands
    the logits to the built-in as they are, so the tokens are the built-in's. It reads the tokens' text through the
    request's tokenizer (Idrak's SamplerRequest.Tokenizer) and the prompt's layout through FillInMiddleFormats.

    Built only on Craft.Abstractions and Idrak.Abstraction (TokenSamplers and FillInMiddleFormats live there, shared with the
    host and with Craft.Ai's generators), so it carries no Idrak library of its own. Android (phase M): no reflection.
  -->
  <PropertyGroup>
    <RootNamespace>Craft.Plugins.Sampler</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Craft.Tests" />
    <InternalsVisibleTo Include="Craft.Benches" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Craft.Abstractions\Craft.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Idrak.Abstraction comes through Craft.Abstractions; as a contract shared with the host it is not copied either. -->
  <Target Name="CraftSharedContractsNotCopied" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Idrak.Abstraction' or '%(Filename)' == 'Craft.Abstractions'" />
    </ItemGroup>
  </Target>

</Project>
