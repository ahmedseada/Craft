<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plug-in P5 of plan phase P, the approve-each command sandbox: an Idrak ICommandSandbox registered in CommandSandboxes as
    "approve-each" (a new kind there). Every command a model's agent asks to run is shown to the user first (the program,
    its time limit, its network, its folder; Allow once / Allow PROGRAM for this run / Deny and tell the agent), then run in
    the sandbox the setting "inner" names ("process" by default, which Idrak.Text registers) with its output live in the
    editor's sandbox terminal panel; a denied command returns a refusal to the agent. With no editor to ask (the idrak tool,
    a host without a presenter) every command is refused: nothing runs without the user.

    Built only on Craft.Abstractions and Idrak.Abstraction (CommandSandboxes lives there, shared with the host and with
    Craft.Ai's agent), so it carries no Idrak library of its own. Android (phase M): no reflection.
  -->
  <PropertyGroup>
    <RootNamespace>Craft.Plugins.Sandbox</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Craft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Craft.Abstractions\Craft.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Idrak.Abstraction comes through Craft.Abstractions; as a contract shared with the host it is not copied either. -->
  <Target Name="CraftSharedContractsNotCopied" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Idrak.Abstraction' or '%(Filename)' == 'Craft.Abstractions'" />
    </ItemGroup>
  </Target>

</Project>
