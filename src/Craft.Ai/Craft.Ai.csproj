<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Craft.Ai (plan 1, phase A1): the AI host the AI plug-ins sit on, built only on Craft's public plug-in contracts
    (Craft.Abstractions) and Idrak. The editor's tools are a plug-in of their own since phase P1 (plugins\Craft.Plugins.Tools,
    read here only through Craft.Abstractions' EditorToolSets); this host serves every registered set's live tools to MCP
    clients through Idrak.Mcp's McpHost over "http", and holds the "local" model provider (names through Idrak's
    ModelSources, loaded once and kept by ModelHost).

    A pre-installed, removable plug-in, as Craft.CSharp is: Craft.App copies this project's output folder to
    plugins\Craft.Ai\ (without the host's Craft.Abstractions and Idrak.Abstraction, which come from the host);
    CRAFT_PLUGINS_DISABLED=Craft.Ai turns it off.

    Android (phase M): Idrak.Mcp is AOT-compatible; Idrak and Idrak.Text are the library's (their own AOT notes apply).
  -->
  <PropertyGroup>
    <RootNamespace>Craft.Ai</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Craft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Craft.Abstractions\Craft.Abstractions.csproj" />
    <PackageReference Include="Idrak.Mcp" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Text" Version="$(IdrakVersion)" />
    <!-- Idrak.Data adds the Hugging Face model source: a model named by its Hugging Face id resolves and downloads. -->
    <PackageReference Include="Idrak.Data" Version="$(IdrakVersion)" />
    <!-- The model families the "local" provider can load: Idrak's own plug-in package, registered on the first load
         (the setting idrakPlugins names the packages; empty registers none). No family is written in Craft. -->
    <PackageReference Include="Idrak.Text.Plugins" Version="$(IdrakVersion)" />
  </ItemGroup>

  <!-- Its plugin.json goes beside its dll (copied by a target, not as content, so it does not flow into the tests). -->
  <Target Name="CraftCopyPluginManifest" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)plugin.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
