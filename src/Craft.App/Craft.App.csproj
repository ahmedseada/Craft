<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Craft, the app. Windows only until the owner says "compile Android" (plan 1, phase M). It builds and runs on Windows
    (Visual Studio's .NET MAUI workload, or `dotnet workload install maui-windows` once for the command line):
      dotnet build -c Release src\Craft.App -f net10.0-windows10.0.19041.0
      src\Craft.App\bin\Release\net10.0-windows10.0.19041.0\win-x64\Craft.App.exe [FILE]
    Unpackaged (WindowsPackageType None): a plain .exe, no certificate, the Windows App SDK's runtime beside it
    (WindowsAppSDKSelfContained), so the folder runs on a machine without that runtime installed.

    On another system the project stops at once, saying so: the WinUI tools run only on Windows.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged, the taskbar takes the .exe's own icon (and the window's, set in Platforms/Windows/WindowIcon.cs). -->
    <ApplicationIcon>Platforms\Windows\appicon.ico</ApplicationIcon>
    <!-- The crash dialog calls Win32's MessageBoxW through a generated LibraryImport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Craft.App</RootNamespace>
    <ApplicationTitle>Craft</ApplicationTitle>
    <ApplicationId>io.github.ahmedseada.craft</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <Target Name="CraftAppWindowsOnly" BeforeTargets="CollectPackageReferences;PrepareForBuild" Condition="!$([MSBuild]::IsOSPlatform('windows'))">
    <Error Text="Craft.App builds on Windows only until the owner says &quot;compile Android&quot; (plan 1, phase M). Build Craft.Maui, Craft.Editor or tests\Craft.Tests here." />
  </Target>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="..\Craft.Maui\Craft.Maui.csproj" />
    <!-- The app's icon: MAUI makes the .exe's and the window's icon from it (and Android's launcher icon in phase M). -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#101217" />
    <!-- The same icon as an .ico beside the program, for the window (WindowIcon.cs); made from appicon.svg at 16 to 256 px. -->
    <None Update="Platforms\Windows\appicon.ico" CopyToOutputDirectory="PreserveNewest" TargetPath="appicon.ico" />
    <!-- Phase D: Inter (the interface) and JetBrains Mono (the code), both SIL Open Font License 1.1 (their licences beside
         them, Resources\Fonts\*-OFL.txt), registered by MauiProgram under Craft.Maui's CraftFonts aliases. -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <Content Include="Resources\Fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
    <!-- C# is a pre-installed plug-in, not part of the app: built first, never referenced, copied to plugins\Craft.CSharp\. -->
    <ProjectReference Include="..\Craft.CSharp\Craft.CSharp.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The AI host (plan phase A1) is a pre-installed plug-in too: built first, never referenced, copied to plugins\Craft.Ai\. -->
    <ProjectReference Include="..\Craft.Ai\Craft.Ai.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    The pre-installed C# plug-in: Craft.CSharp is built as a plain library (no runtime identifier, so its own output folder
    bin\<Configuration>\net10.0\), and that folder (Craft.CSharp.dll, Roslyn's assemblies, Craft.CSharp.deps.json, and the
    plugin.json that Craft.CSharp's own build copies there from src\Craft.CSharp\plugin.json; never the host's Craft.Abstractions, Craft.Core or
    Idrak.Abstraction) is copied to
    plugins\Craft.CSharp\ beside the program after Build, and beside the published program after Publish. Deleting that
    folder (or CRAFT_PLUGINS_DISABLED=csharp) removes C#; the app still starts, opening .cs files as plain text.
  -->
  <Target Name="CraftCSharpPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Craft.CSharp\Craft.CSharp.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;Platform;PlatformTarget;OutDir;OutputPath;PublishDir;WindowsPackageType;WindowsAppSDKSelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CraftCSharpPluginAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_CraftCSharpPluginFolder>@(_CraftCSharpPluginAssembly->'%(RootDir)%(Directory)')</_CraftCSharpPluginFolder>
    </PropertyGroup>
    <Error Condition="'$(_CraftCSharpPluginFolder)' == '' or !Exists('$(_CraftCSharpPluginFolder)')" Text="The C# plug-in's build output was not found (Craft.CSharp built to '$(_CraftCSharpPluginFolder)')." />
    <Error Condition="!Exists('$(_CraftCSharpPluginFolder)plugin.json')" Text="The C# plug-in's plugin.json was not found in its build output ('$(_CraftCSharpPluginFolder)'): Craft.CSharp's CraftCopyPluginManifest target puts it there." />
    <ItemGroup>
      <!-- The host's own contracts are never copied: the app provides them, so the plug-in shares the same types. -->
      <_CraftCSharpPluginFile Include="$(_CraftCSharpPluginFolder)**\*"
                              Exclude="$(_CraftCSharpPluginFolder)Craft.Abstractions.*;$(_CraftCSharpPluginFolder)Idrak.Abstraction.*;$(_CraftCSharpPluginFolder)Craft.Core.*" />
    </ItemGroup>
  </Target>

  <Target Name="CraftCopyCSharpPlugin" AfterTargets="Build" DependsOnTargets="CraftCSharpPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <Copy SourceFiles="@(_CraftCSharpPluginFile)" DestinationFiles="@(_CraftCSharpPluginFile->'$(OutDir)plugins\Craft.CSharp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CraftPublishCSharpPlugin" AfterTargets="Publish" DependsOnTargets="CraftCSharpPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <Copy SourceFiles="@(_CraftCSharpPluginFile)" DestinationFiles="@(_CraftCSharpPluginFile->'$(PublishDir)plugins\Craft.CSharp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The pre-installed AI host (plan phase A1), as the C# plug-in: Craft.Ai's own output folder (Craft.Ai.dll, Idrak's
    assemblies it loads in its own context, Craft.Ai.deps.json, plugin.json) copied to plugins\Craft.Ai\ after Build and
    Publish, never the host's Craft.Abstractions, Craft.Core or Idrak.Abstraction. Deleting the folder (or
    CRAFT_PLUGINS_DISABLED=Craft.Ai) removes it; the app still starts.
  -->
  <Target Name="CraftAiPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Craft.Ai\Craft.Ai.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;Platform;PlatformTarget;OutDir;OutputPath;PublishDir;WindowsPackageType;WindowsAppSDKSelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CraftAiPluginAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_CraftAiPluginFolder>@(_CraftAiPluginAssembly->'%(RootDir)%(Directory)')</_CraftAiPluginFolder>
    </PropertyGroup>
    <Error Condition="'$(_CraftAiPluginFolder)' == '' or !Exists('$(_CraftAiPluginFolder)plugin.json')" Text="The AI plug-in's build output or its plugin.json was not found (Craft.Ai built to '$(_CraftAiPluginFolder)')." />
    <ItemGroup>
      <_CraftAiPluginFile Include="$(_CraftAiPluginFolder)**\*"
                          Exclude="$(_CraftAiPluginFolder)Craft.Abstractions.*;$(_CraftAiPluginFolder)Idrak.Abstraction.*;$(_CraftAiPluginFolder)Craft.Core.*" />
    </ItemGroup>
  </Target>

  <Target Name="CraftCopyAiPlugin" AfterTargets="Build" DependsOnTargets="CraftAiPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <Copy SourceFiles="@(_CraftAiPluginFile)" DestinationFiles="@(_CraftAiPluginFile->'$(OutDir)plugins\Craft.Ai\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CraftPublishAiPlugin" AfterTargets="Publish" DependsOnTargets="CraftAiPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <Copy SourceFiles="@(_CraftAiPluginFile)" DestinationFiles="@(_CraftAiPluginFile->'$(PublishDir)plugins\Craft.Ai\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The plug-ins of plan phase P (plugins\<Name>\<Name>.csproj, each its own folder: P1 the editor's tools, P2 a coder model
    family, P3 the bracket-balanced sampler, P4 the C#-aware edit placement, P5 the approve-each sandbox), pre-installed as
    Craft.CSharp and Craft.Ai are: each built as a plain library, never referenced, its output folder (its dll, its own
    dependencies, its .deps.json and the plugin.json its build copies there) copied to plugins\<Name>\ after Build and
    Publish, never the host's Craft.Abstractions, Craft.Core or Idrak.Abstraction. Deleting a folder (or naming it in
    CRAFT_PLUGINS_DISABLED) removes that plug-in; the app still starts.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <CraftPreinstalledPlugin Include="$(MSBuildThisFileDirectory)..\..\plugins\*\*.csproj" />
  </ItemGroup>

  <Target Name="CraftPreinstalledPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <MSBuild Projects="@(CraftPreinstalledPlugin)" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;Platform;PlatformTarget;OutDir;OutputPath;PublishDir;WindowsPackageType;WindowsAppSDKSelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CraftPreinstalledAssembly" />
    </MSBuild>
    <Error Condition="!Exists('%(_CraftPreinstalledAssembly.RootDir)%(_CraftPreinstalledAssembly.Directory)plugin.json')"
           Text="The plug-in %(_CraftPreinstalledAssembly.Filename)'s plugin.json was not found in its build output: plugins\Directory.Build.targets copies it there." />
    <ItemGroup>
      <_CraftPreinstalledFile Include="%(_CraftPreinstalledAssembly.RootDir)%(_CraftPreinstalledAssembly.Directory)**\*"
                              Exclude="%(_CraftPreinstalledAssembly.RootDir)%(_CraftPreinstalledAssembly.Directory)Craft.Abstractions.*;%(_CraftPreinstalledAssembly.RootDir)%(_CraftPreinstalledAssembly.Directory)Idrak.Abstraction.*;%(_CraftPreinstalledAssembly.RootDir)%(_CraftPreinstalledAssembly.Directory)Craft.Core.*"
                              Plugin="%(_CraftPreinstalledAssembly.Filename)" />
    </ItemGroup>
  </Target>

  <Target Name="CraftCopyPreinstalledPlugins" AfterTargets="Build" DependsOnTargets="CraftPreinstalledPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <Copy SourceFiles="@(_CraftPreinstalledFile)" DestinationFiles="@(_CraftPreinstalledFile->'$(OutDir)plugins\%(Plugin)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CraftPublishPreinstalledPlugins" AfterTargets="Publish" DependsOnTargets="CraftPreinstalledPluginFiles" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <Copy SourceFiles="@(_CraftPreinstalledFile)" DestinationFiles="@(_CraftPreinstalledFile->'$(PublishDir)plugins\%(Plugin)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('windows'))">
    <Compile Remove="**/*.cs" />
  </ItemGroup>

</Project>
