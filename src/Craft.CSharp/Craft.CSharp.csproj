<Project Sdk="Microsoft.NET.Sdk">

  <!--
    C# on Roslyn, registered as the "csharp" language (CSharpLanguage.Register). E2: the syntactic layer, on Roslyn's
    parser (Microsoft.CodeAnalysis.CSharp); E5: the semantic layer, on Workspaces and Features (an AdhocWorkspace per
    folder with MEF host services composed from this plug-in's own assemblies; no MSBuildWorkspace, which needs the SDK). Not marked
    AOT-compatible: Roslyn's MEF composition uses reflection, and for Android (phase M) its assemblies are rooted for the
    trimmer.
  -->
  <PropertyGroup>
    <RootNamespace>Craft.CSharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A plug-in, loaded from the app's plugins/Craft.CSharp/ folder: its output carries Roslyn and a .deps.json, and not
         the contracts it shares with the host (Craft.Abstractions, Idrak.Abstraction), which come from the host. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The session's test hooks (holding the parse worker, failing a parse) are internal. -->
    <InternalsVisibleTo Include="Craft.Tests" />
    <!-- The semantic bench builds a workspace without a session (CSharpWorkspace is internal). -->
    <InternalsVisibleTo Include="Craft.Benches" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(RoslynVersion)" />
    <ProjectReference Include="..\Craft.Abstractions\Craft.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Idrak.Abstraction comes through Craft.Abstractions; as a contract shared with the host it is not copied either. -->
  <Target Name="CraftSharedContractsNotCopied" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Idrak.Abstraction' or '%(Filename)' == 'Craft.Abstractions'" />
    </ItemGroup>
  </Target>

  <!-- Its plugin.json (name, version, summary, the contract version it was built against) goes beside its dll in its own
       output folder, which Craft.App copies to plugins\Craft.CSharp\. Copied by a target, not as content, so it never
       flows into the output of a project that references this one (the tests). -->
  <Target Name="CraftCopyPluginManifest" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)plugin.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
