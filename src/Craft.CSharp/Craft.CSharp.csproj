<Project Sdk="Microsoft.NET.Sdk">

  <!--
    C# on Roslyn, registered as the "csharp" language (CSharpLanguage.Register). E2: the syntactic layer, on Roslyn's
    parser alone (Microsoft.CodeAnalysis.CSharp); E5 adds Workspaces and Features for the semantic layer. Not marked
    AOT-compatible: Roslyn's MEF composition uses reflection, and for Android (phase M) its assemblies are rooted for the
    trimmer.
  -->
  <PropertyGroup>
    <RootNamespace>Craft.CSharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <ProjectReference Include="..\Craft.Abstractions\Craft.Abstractions.csproj" />
  </ItemGroup>

</Project>
