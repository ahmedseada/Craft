<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The editor without a UI: caret, selection, commands, layout, hit-testing, find and replace, bracket matching, and the
    drawing of the visible lines through IEditorCanvas. Every UI (Craft.Maui) hosts it; the tests drive it headless.
  -->
  <PropertyGroup>
    <RootNamespace>Craft.Editor</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Craft.Core\Craft.Core.csproj" />
  </ItemGroup>

  <!-- X part 9: the spell check's bundled word lists (plain text, no native library); SCOWL's licence beside them. -->
  <ItemGroup>
    <EmbeddedResource Include="Spelling\Words\en.txt" LogicalName="Craft.Editor.Spelling.Words.en.txt" />
    <EmbeddedResource Include="Spelling\Words\code.txt" LogicalName="Craft.Editor.Spelling.Words.code.txt" />
    <None Include="Spelling\Words\scowl-license.txt" />
  </ItemGroup>

</Project>
