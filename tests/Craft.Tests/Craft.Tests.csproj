<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Craft's tests: one program with its own small runner and the flags of Idrak's (plan 1, "Tests and benches"): progress,
    failures-only and failures-file (the owner's command list in CLAUDE.md shows them). CRAFT_FILTER (or the filter flag)
    picks tests whose name contains any of its "|"-separated texts, ignoring case. CRAFT_UPDATE=1 rewrites the public API
    dumps (api/*.txt) and the registry inventory (plans/inventory.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Craft.Tests</RootNamespace>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Craft.Abstractions\Craft.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Craft.Core\Craft.Core.csproj" />
    <ProjectReference Include="..\..\src\Craft.Editor\Craft.Editor.csproj" />
    <ProjectReference Include="..\..\src\Craft.CSharp\Craft.CSharp.csproj" />
    <ProjectReference Include="..\..\src\Craft.Web\Craft.Web.csproj" />
    <ProjectReference Include="..\..\src\Craft.Ai\Craft.Ai.csproj" />
    <!-- Built, not referenced: the one test build also compiles the MAUI views (net10.0), so a change or a merge that breaks
         them fails here, not first on the owner's app build. -->
    <ProjectReference Include="..\..\src\Craft.Maui\Craft.Maui.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net10.0" SkipGetTargetFrameworkProperties="true" />
    <!-- The plug-ins of phase P (plugins/): referenced for their API dumps and their own tests; the Plugins group also loads
         each from a copy of its own output folder through CraftPlugins.LoadFolder, as the app does. -->
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Tools\Craft.Plugins.Tools.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.StarCoder2\Craft.Plugins.StarCoder2.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Sampler\Craft.Plugins.Sampler.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Sandbox\Craft.Plugins.Sandbox.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Placement\Craft.Plugins.Placement.csproj" />
    <!-- Phase V's voice plug-in (P7 its first part): its headless tests, and loaded from a copy of its folder (Voice group). -->
    <ProjectReference Include="..\..\plugins\Craft.Voice\Craft.Voice.csproj" />
    <!-- Phase R's learning plug-in (group Learning): referenced for its API dump and its tests; also loaded from a copy of its output. -->
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Learning\Craft.Plugins.Learning.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Git\Craft.Plugins.Git.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Json\Craft.Plugins.Json.csproj" />
    <!-- Phase W's npm plug-in (group WebNpm): its API dump and its tests; also loaded from a copy of its output. -->
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Npm\Craft.Plugins.Npm.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Css\Craft.Plugins.Css.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.JavaScript\Craft.Plugins.JavaScript.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.TypeScript\Craft.Plugins.TypeScript.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Html\Craft.Plugins.Html.csproj" />
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Angular\Craft.Plugins.Angular.csproj" />
    <!-- Phase W's lint plug-in (group WebLint): its API dump and its tests; also loaded from a copy of its output. -->
    <ProjectReference Include="..\..\plugins\Craft.Plugins.Lint\Craft.Plugins.Lint.csproj" />
    <!-- Idrak's conformance suites (FillInMiddleFormatSuite, TokenSamplerSuite, TextMatcherSuite) for the plug-ins of phase P. -->
    <PackageReference Include="Idrak.Abstraction.Testing" Version="$(IdrakVersion)" />
    <!-- The sample plug-in (PluginKit group): built first, never referenced; the tests copy its output folder into a
         temporary plugins/ folder and load it from there, as the app would. -->
    <ProjectReference Include="..\..\samples\Craft.Plugins.Sample\Craft.Plugins.Sample.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
